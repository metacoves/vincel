<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
      DPI 感知声明改放在 app.manifest 里了。这里原来试过用
      System.Windows.Forms.ApplicationConfigurationSection 声明 DpiAwareness，
      写探测程序实测过——不生效，进程实际还是 UNAWARE。manifest 才是真正管用的地方。
    -->
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
